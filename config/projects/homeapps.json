{
  "$schema": "../schemas/projects.schema.json",
  "name": "homeapps",
  "description": "OPI applications at stratusplein 1",
  "roots": {},
  "projects": {},
  "owner": "joost@xyz9.net",
  "owner_group": "homeapps-owners",
  "applications": {
    "docker": {
      "host": {
        "dns_name": "opi-private",
        "user": "joost",
        "config_root": "/home/joost/docker/config",
        "data_root": "/home/joost/docker/data",
        "tls_root": "/home/joost/tls"
      },
      "rsync_excludes": [
        ".env",
        "*.env",
        "mailserver/config/"
      ],
      "host_secrets": {
        "postgres_env": {
          "vault_secret": "homeapps-opi-postgres-env",
          "dest": "postgres/.env",
          "mode": "0600"
        },
        "vaultwarden_env": {
          "vault_secret": "homeapps-opi-vaultwarden-env",
          "dest": "vaultwarden/.env",
          "mode": "0600"
        },
        "mailserver_accounts": {
          "vault_secret": "homeapps-opi-mailserver-accounts",
          "dest": "mailserver/config/postfix-accounts.cf",
          "mode": "0600"
        }
      },
      "data_directories": {
        "homeassistant": {
          "path": "homeassistant",
          "backup": "required",
          "method": "sqlite_file_backup",
          "contains_secrets": true,
          "notes": "SQLite files are snapshotted with the backup API while Home Assistant is running. backups, deps, and tts stay on OPI.",
          "exclude": [
            "backups",
            "deps",
            "tts"
          ]
        },
        "mailserver": {
          "path": "mailserver",
          "backup": "none",
          "method": "file_backup",
          "contains_secrets": true,
          "notes": "No automated backup. Preserve ownership and permissions for mail and mail-state if copying manually."
        },
        "nginx": {
          "path": "nginx",
          "backup": "none",
          "method": "file_backup",
          "contains_secrets": false,
          "notes": "Access and error logs. Disposable; not a backup target."
        },
        "postgres": {
          "path": "postgres",
          "backup": "none",
          "method": "pg_dump",
          "contains_secrets": true,
          "notes": "No automated backup. Prefer pg_dump for any manual export."
        },
        "unifi": {
          "path": "unifi",
          "backup": "none",
          "method": "application_backup",
          "source": "data/backup",
          "contains_secrets": true,
          "notes": "Controller autobackup under data/backup. The rest of the UniFi tree, including the vendor checkout, stays on OPI.",
          "exclude": [
            "log",
            "run"
          ]
        },
        "vaultwarden": {
          "path": "vaultwarden",
          "backup": "required",
          "method": "bitwarden_encrypted_json",
          "contains_secrets": true,
          "notes": "Consistent SQLite snapshot plus attachments. A Bitwarden encrypted JSON export is uploaded beside it; the export password is the Key Vault secret named in backup.vaultwarden_export."
        }
      },
      "backup": {
        "account": "xz9saiac",
        "container": "homeapps-opi",
        "schedule": "*-*-* 03:30:00",
        "retain_days": 30,
        "azcopy_version": "10.30.1",
        "vaultwarden_export": {
          "server": "https://vault.xyz9.net",
          "secrets": {
            "client_id": "homeapps-opi-vaultwarden-bw-clientid",
            "client_secret": "homeapps-opi-vaultwarden-bw-clientsecret",
            "master_password": "homeapps-opi-vaultwarden-bw-master-password",
            "export_password": "homeapps-opi-vaultwarden-bw-export-password"
          }
        }
      },
      "services": {
        "homeassistant": {
          "enabled": true,
          "manage_compose": true,
          "compose": {
            "services": {
              "homeassistant": {
                "container_name": "homeassistant",
                "image": "ghcr.io/home-assistant/home-assistant:stable",
                "devices": [
                  "/dev/ttyUSB0"
                ],
                "volumes": [
                  "$data_root/homeassistant/config:/config",
                  "$tls_root/ha:/tls",
                  "/etc/localtime:/etc/localtime:ro",
                  "/run/dbus:/run/dbus:ro"
                ],
                "environment": [
                  "TZ=Europe/Amsterdam"
                ],
                "restart": "always",
                "privileged": true,
                "network_mode": "host"
              }
            }
          }
        },
        "mailserver": {
          "enabled": true,
          "manage_compose": true,
          "compose": {
            "services": {
              "mailserver": {
                "image": "ghcr.io/docker-mailserver/docker-mailserver:latest",
                "container_name": "mailserver",
                "hostname": "mx1.xyz9.net",
                "domainname": "xyz9.net",
                "network_mode": "host",
                "volumes": [
                  "$data_root/mailserver/mail:/var/mail/",
                  "$data_root/mailserver/mail-state:/var/mail-state/",
                  "$data_root/mailserver/log/mail:/var/log/mail/",
                  "$config_root/mailserver/config:/tmp/docker-mailserver/",
                  "/etc/localtime:/etc/localtime:ro",
                  "$tls_root/mx1:/tls/mx1"
                ],
                "restart": "always",
                "stop_grace_period": "1m",
                "healthcheck": {
                  "test": "ss --listening --ipv4 --tcp | grep --silent ':smtp' || exit 1",
                  "timeout": "3s",
                  "retries": 0
                },
                "environment": [
                  "LOG_LEVEL=info",
                  "TZ=Europe/Amsterdam",
                  "ENABLE_IMAP=1",
                  "SSL_TYPE=manual",
                  "SSL_CERT_PATH=/tls/mx1/fullchain.pem",
                  "SSL_KEY_PATH=/tls/mx1/privkey.pem",
                  "NETWORK_INTERFACE=end1"
                ]
              }
            }
          }
        },
        "nginx": {
          "enabled": true,
          "manage_compose": true,
          "compose": {
            "services": {
              "nginx": {
                "image": "nginx:stable-alpine",
                "container_name": "nginx",
                "restart": "unless-stopped",
                "network_mode": "host",
                "volumes": [
                  "$config_root/nginx/nginx.conf:/etc/nginx/nginx.conf:ro",
                  "$config_root/nginx/conf.d:/etc/nginx/conf.d:ro",
                  "$tls_root:/etc/nginx/certs:ro",
                  "$data_root/nginx:/var/log/nginx"
                ],
                "read_only": true,
                "tmpfs": [
                  "/var/cache/nginx",
                  "/var/run",
                  "/tmp"
                ],
                "security_opt": [
                  "no-new-privileges:true"
                ],
                "healthcheck": {
                  "test": [
                    "CMD-SHELL",
                    "wget -q --spider http://127.0.0.1/nginx-health || exit 1"
                  ],
                  "interval": "30s",
                  "timeout": "5s",
                  "retries": 3,
                  "start_period": "10s"
                }
              }
            }
          }
        },
        "postgres": {
          "enabled": true,
          "manage_compose": true,
          "compose": {
            "services": {
              "postgress": {
                "container_name": "postgres",
                "image": "postgres:17",
                "restart": "always",
                "shm_size": "256mb",
                "ports": [
                  "5432:5432"
                ],
                "volumes": [
                  "$data_root/postgres/pgdata:/var/lib/postgresql/data",
                  "$data_root/postgres/pgcerts:/var/lib/postgresql/certs"
                ],
                "environment": {
                  "POSTGRES_USER": "postgres@xyz9.net",
                  "POSTGRES_DB": "postgres",
                  "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
                  "PGSSLROOTCERT": "/var/lib/postgresql/certs/xyz9-ca.pem",
                  "PGSSLCERT": "/var/lib/postgresql/certs/xyz9-opi.pem",
                  "PGSSLKEY": "/var/lib/postgresql/certs/xyz9-opi-key.pem"
                }
              }
            }
          },
          "env_files": [
            "postgres/.env"
          ]
        },
        "unifi": {
          "enabled": true,
          "manage_compose": true,
          "compose": {
            "services": {
              "unifi": {
                "container_name": "unifi",
                "image": "unifi-joost",
                "user": "unifi",
                "ports": [
                  "8080:8080",
                  "8443:8443",
                  "3478:3478/udp"
                ],
                "environment": [
                  "TZ=Europe/Amsterdam",
                  "UNIFI_GID=1000",
                  "UNIFI_UID=1000"
                ],
                "volumes": [
                  "$data_root/unifi:/unifi",
                  "/etc/localtime:/etc/localtime:ro",
                  "/run/dbus:/run/dbus:ro",
                  "$tls_root/unifi:/tls"
                ],
                "restart": "unless-stopped",
                "network_mode": "host",
                "privileged": true
              }
            }
          }
        },
        "vaultwarden": {
          "enabled": true,
          "manage_compose": true,
          "compose": {
            "services": {
              "vaultwarden": {
                "container_name": "vaultwarden",
                "image": "vaultwarden/server:latest",
                "restart": "unless-stopped",
                "network_mode": "host",
                "environment": [
                  "TZ=Europe/Amsterdam",
                  "ROCKET_ADDRESS=127.0.0.1",
                  "ROCKET_PORT=8081",
                  "DOMAIN=https://vault.xyz9.net",
                  "SIGNUPS_ALLOWED=false",
                  "WEBSOCKET_ENABLED=true",
                  "PUSH_ENABLED=true",
                  "PUSH_INSTALLATION_ID=${PUSH_INSTALLATION_ID}",
                  "PUSH_INSTALLATION_KEY=${PUSH_INSTALLATION_KEY}",
                  "ADMIN_TOKEN=${ADMIN_TOKEN}"
                ],
                "volumes": [
                  "$data_root/vaultwarden:/data"
                ]
              }
            }
          },
          "env_files": [
            "vaultwarden/.env"
          ]
        }
      }
    }
  }
}
