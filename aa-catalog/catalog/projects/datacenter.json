      "roles": ["admin", "engineer"]
    },
    "regions": {
      "apc": {
        "roles": ["manager"]
      }
    }
  },
  "locations": {
    "apc1": {
      "region": "CentralIndia",
      "address_space": ["172.16.64.0/20", "fd17:16:0:10::/60"],
      "spokes_address_space": ["10.16.64.0/20", "fd10:0:0:0::/60"]
    }
  },
  "offices": {
    "sp1": {
      "name": "stratusplein 1",
      "network": {
        "address_space": ["172.17.114.0/24", "fd17:114::/64"],
        "router": "egx",
        "lan": {
          "interface": "eth1",
          "addresses": ["172.17.114.4/24", "fd17:114::4/64"]
        },
        "wan": {
          "interface": "pppoe0",
          "parent": "eth0.6",
          "description": "kpn wan",
          "user_id": "18-e8-29-43-ae-89@internet",
          "ipv6_pd": {
            "prefix_length": 48,
            "interface": "eth1",
            "prefix_id": ":1",
            "host_address": "::1"
          },
          "nat": "masquerade"
        },
        "dhcp": {
          "subnet": "172.17.114.0/24",
          "router": "172.17.114.4",
          "dns": "172.17.114.4",
          "domain": "xyz9.net",
          "start": "172.17.114.10",
          "stop": "172.17.114.100",
          "lease": 7200,
          "unifi_controller": "172.17.114.27"
        },
        "dns": {
          "listen": "eth1",
          "strict_order": true,
          "servers": ["172.16.64.4", "fd17:16:0:10::4", "8.8.8.8", "2001:4860:4860::8888"]
        },
        "address_groups": {
          "dbt_allowed": ["52.3.77.232", "3.214.191.130", "34.233.79.135"]
        },
        "forwards": {
          "hairpin_nat": true,
          "auto_firewall": false,
          "rules": {
            "25": {"description": "SMTP", "address": "172.17.114.99", "port": 25, "protocol": "tcp"},
            "143": {"description": "IMAP", "address": "172.17.114.99", "port": 143, "protocol": "tcp"},
            "443": {"description": "web", "address": "172.17.114.99", "port": 443, "protocol": "tcp"},
            "465": {"description": "ESMTP", "address": "172.17.114.99", "port": 465, "protocol": "tcp"},
            "587": {"description": "ESMTP-TLS", "address": "172.17.114.99", "port": 587, "protocol": "tcp"},
            "993": {"description": "IMAP4", "address": "172.17.114.99", "port": 993, "protocol": "tcp"},
            "2222": {"description": "SSH to opi", "address": "172.17.114.99", "port": 22, "protocol": "tcp"},
            "5432": {"description": "postgresql", "address": "172.17.114.99", "port": 5432, "protocol": "tcp", "source_group": "dbt_allowed"},
            "8080": {"description": "unifi-device", "address": "172.17.114.99", "port": 8080, "protocol": "tcp"}
          }
        }
      }
    }
