{
  "$schema": "../schemas/projects.schema.json",
  "name": "datacenter",
  "description": "My little az datacenter",
  "roots": {},
  "projects": {},
  "owner": "joost@xyz9.net",
  "owner_group": "datacenter-owners",
  "devops": {
    "owner": "homeapps",
    "project": {
      "name": "xyz9it"
    }
  },
  "credentials": {
    "secret_names": ["cloudflare-dns-editzonekey", "cloudflare-dns-zoneid"]
  },
  "azure": {
    "rg": {
      "name": "rg-datacenter",
      "location": "CentralIndia"
    },
    "private_dns_zones": [
      "privatelink.blob.core.windows.net",
