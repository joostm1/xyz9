{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xyz9.net/schemas/projects.schema.json",
  "title": "xyz9 project config",
  "description": "Project config object: git seed under projects/, then living as KV secret and/or root output.config. Contributions accumulate under roots (by state_key) and projects (by projectName).",
  "type": "object",
  "required": [
    "name",
    "owner",
    "description",
    "roots",
    "projects"
  ],
  "$defs": {
    "cidr_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12,
      "pattern": "^[a-zA-Z0-9]{3,12}$",
      "description": "Project name; 3–8 alphanumeric characters; usually matches the filename stem"
    },
    "owner": {
      "type": "string",
      "format": "email",
      "description": "Project owner email"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short project description"
    },
    "roots": {
      "type": "object",
      "description": "Same-project root-module contributions keyed by state_key; empty in the git seed",
      "additionalProperties": {
        "type": "object"
      }
    },
    "hub_location": {
      "type": "string",
      "description": "Hub location code from `projects/datacenter.json`, locations key. Only set this for projects that land on a connected hub.",
      "enum": ["apc1", "apc2", "eas1"]
    },
    "locations": {
      "type": "object",
      "description": "datacenter hub locations. Only set on the datacenter project seed.",
      "additionalProperties": {
        "type": "object",
        "required": ["region", "address_space", "spokes_address_space"],
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "address_space": {
            "$ref": "#/$defs/cidr_list"
          },
          "spokes_address_space": {
            "$ref": "#/$defs/cidr_list"
          }
        }
      }
    },
    "offices": {
      "type": "object",
      "description": "Office sites that join the hub IPsec mesh, keyed by office code. Set on the owning project seed (currently datacenter).",
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human name of the office, e.g. stratusplein 1"
          },
          "network": {
            "type": "object",
            "description": "Prefixes this office advertises, its router DNS label, and the LAN, WAN, DHCP, DNS, and inbound forwards taken from that router. Passwords stay on the router.",
            "additionalProperties": false,
            "required": ["address_space", "router", "lan", "wan", "dhcp", "dns", "forwards"],
            "properties": {
              "address_space": {
                "$ref": "#/$defs/cidr_list",
                "description": "IPv4/IPv6 prefixes advertised as IPsec traffic selectors"
              },
              "router": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "Router DNS label (e.g. egx). IKE identity is {router}.{dns_domain}; peers reach it at {router}-ipv4.{dns_domain}"
              },
              "lan": {
                "type": "object",
                "additionalProperties": false,
                "required": ["interface", "addresses"],
                "properties": {
                  "interface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "addresses": {
                    "$ref": "#/$defs/cidr_list"
                  }
                }
              },
              "wan": {
                "type": "object",
                "additionalProperties": false,
                "required": ["interface", "parent", "nat"],
                "properties": {
                  "interface": {
                    "type": "string",
                    "minLength": 1,
                    "description": "WAN interface used for NAT and port-forward, e.g. pppoe0"
                  },
                  "parent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Device under the WAN interface, e.g. eth0.6"
                  },
                  "description": {
                    "type": "string"
                  },
                  "user_id": {
                    "type": "string",
                    "description": "PPPoE user-id. The password stays on the router."
                  },
                  "ipv6_pd": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["prefix_length", "interface", "prefix_id", "host_address"],
                    "properties": {
                      "prefix_length": {
                        "type": "integer"
                      },
                      "interface": {
                        "type": "string"
                      },
                      "prefix_id": {
                        "type": "string"
                      },
                      "host_address": {
                        "type": "string"
                      }
                    }
                  },
                  "nat": {
                    "type": "string",
                    "enum": ["masquerade"]
                  }
                }
              },
              "dhcp": {
                "type": "object",
                "additionalProperties": false,
                "required": ["subnet", "router", "dns", "domain", "start", "stop"],
                "properties": {
                  "subnet": {
                    "type": "string"
                  },
                  "router": {
                    "type": "string"
                  },
                  "dns": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string"
                  },
                  "stop": {
                    "type": "string"
                  },
                  "lease": {
                    "type": "integer"
                  },
                  "unifi_controller": {
                    "type": "string"
                  }
                }
              },
              "dns": {
                "type": "object",
                "additionalProperties": false,
                "required": ["listen", "servers"],
                "properties": {
                  "listen": {
                    "type": "string"
                  },
                  "strict_order": {
                    "type": "boolean"
                  },
                  "servers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "address_groups": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "forwards": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hairpin_nat", "auto_firewall", "rules"],
                "properties": {
                  "hairpin_nat": {
                    "type": "boolean"
                  },
                  "auto_firewall": {
                    "type": "boolean"
                  },
                  "rules": {
                    "type": "object",
                    "description": "Keyed by the WAN port. port is the address on the LAN host.",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["description", "address", "port", "protocol"],
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "address": {
                          "type": "string"
                        },
                        "port": {
                          "type": "integer"
                        },
                        "protocol": {
                          "type": "string",
                          "enum": ["tcp", "udp"]
                        },
                        "source_group": {
                          "type": "string",
                          "description": "Name of an address_groups entry. WAN clients outside that group are dropped."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "applications": {
            "type": "object",
            "description": "Applications hosted at this office, keyed by application name.",
            "additionalProperties": true,
            "properties": {
              "docker": {
                "type": "object",
                "description": "OPI Docker host, services, secrets, and backup policy for this office."
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "object",
      "description": "Cross-project contributions keyed by contributing projectName; empty in the git seed",
      "additionalProperties": {
        "type": "object"
      }
    },
    "devops": {
      "type": "object",
      "description": "Azure DevOps project identity and permission policy. git_acls are named Git ACL maps; permission_sets bind a built-in project group plus Git selectors to those maps; role_permission_sets bind scope roles to permission set names. Git selectors: all = project-level (current and future repos); own.<kind> = repos of that kind whose dataset_key matches the role (e.g. own.adf → nyt.adf for dataset-nyt-engineer).",
      "additionalProperties": true,
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]{3,12}$",
          "description": "Catalog project whose owner principal administers this Azure DevOps project. That project is applied first. Absent means this project administers its own."
        },
        "project": {
          "type": "object",
          "description": "Azure DevOps project identity",
          "properties": {
            "name": {
              "type": "string",
              "description": "Desired Azure DevOps project name"
            },
            "current_name": {
              "type": "string",
              "description": "Live Azure DevOps project name to adopt when it still differs from name"
            },
            "id": {
              "type": "string",
              "description": "Devops project id when already created"
            }
          }
        },
        "git_acls": {
          "type": "object",
          "description": "Named Git ACL maps. Values are Azure DevOps Git permission bits: Allow, Deny, or NotSet.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["Allow", "Deny", "NotSet"]
            }
          }
        },
        "permission_sets": {
          "type": "object",
          "description": "Named permission sets. project_group is a built-in Azure DevOps project group. git maps selectors (all, own.<kind>) to git_acls names.",
          "additionalProperties": {
            "type": "object",
            "required": ["project_group", "git"],
            "properties": {
              "project_group": {
                "type": "string",
                "minLength": 1
              },
              "git": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "role_permission_sets": {
          "type": "object",
          "description": "Maps scope kind (platform, dataset) and role name to a permission_sets key. Bindings are by role, not per dataset instance.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
